# Copy to .env and replace every placeholder. Never commit .env.
ENV=development
GARBLO_CORS_ORIGINS=http://localhost:3000
GARBLO_REQUEST_TIMEOUT_SECONDS=5
GARBLO_RETRY_ATTEMPTS=2

# Backend service Basic Auth. Send as X-Backend-Authorization when a request
# also carries the user's Authorization: Bearer token.
BASIC_AUTH_USERNAME=replace-me
BASIC_AUTH_PASSWORD=replace-me

# External services
GARBLO_MONGODB_URI=mongodb+srv://user:password@cluster.example/garblo
GARBLO_MONGODB_DATABASE=replace
GARBLO_POWERSYNC_URL=https://sync.example
# Backend-only signing settings. The mobile app receives only a short-lived JWT.
GARBLO_POWERSYNC_KEY_ID=prod-rsa-key-1
GARBLO_POWERSYNC_PRIVATE_KEY=replace-with-secret-managed-rsa-private-key
GARBLO_POWERSYNC_AUDIENCE=https://sync.example
# Backend-only S3-compatible credentials. The mobile app receives presigned URLs.
GARBLO_RUSTFS_ENDPOINT=https://files.example
GARBLO_RUSTFS_PORT=443
GARBLO_RUSTFS_USE_SSL=true
GARBLO_RUSTFS_REGION=us-east-1
GARBLO_RUSTFS_ACCESS_KEY=replace-me
GARBLO_RUSTFS_SECRET_KEY=replace-me
GARBLO_OPENAI_API_KEY=replace-me
GARBLO_OPENAI_MODEL=gpt-4o-mini
