{
  "font": {
    "display": {
      "$value": "Newsreader",
      "$type": "fontFamily"
    },
    "sans": {
      "$value": "Inter",
      "$type": "fontFamily"
    },
    "mono": {
      "$value": "JetBrains Mono",
      "$type": "fontFamily"
    }
  },
  "type": {
    "display-hero": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontWeight": 400,
        "fontSize": 52,
        "lineHeight": 1.1,
        "letterSpacing": -0.0375
      },
      "$extensions": {
        "garblo.desktopFontSize": 100
      }
    },
    "display-lookbook": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontWeight": 400,
        "fontSize": 32,
        "lineHeight": 1.15,
        "letterSpacing": -0.025
      },
      "$extensions": {
        "garblo.desktopFontSize": 48
      }
    },
    "heading-section": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontWeight": 500,
        "fontSize": 20,
        "lineHeight": 1.25,
        "letterSpacing": -0.015
      },
      "$extensions": {
        "garblo.desktopFontSize": 24
      }
    },
    "chrome-nav": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontWeight": 400,
        "fontSize": 12,
        "lineHeight": 1.0,
        "letterSpacing": 0.08
      },
      "$extensions": {
        "garblo.desktopFontSize": 13,
        "garblo.uppercase": true
      }
    },
    "body-editorial": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontWeight": 400,
        "fontSize": 15,
        "lineHeight": 1.5,
        "letterSpacing": 0
      },
      "$extensions": {
        "garblo.desktopFontSize": 16
      }
    },
    "product-cell": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontWeight": 500,
        "fontSize": 13,
        "lineHeight": 1.35,
        "letterSpacing": 0.01
      },
      "$extensions": {
        "garblo.desktopFontSize": 14
      }
    },
    "mono-telemetry": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.mono}",
        "fontWeight": 500,
        "fontSize": 12,
        "lineHeight": 1.3,
        "letterSpacing": -0.01
      },
      "$extensions": {
        "garblo.desktopFontSize": 13,
        "garblo.features": [
          "tnum",
          "zero"
        ]
      }
    },
    "mono-badge": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.mono}",
        "fontWeight": 400,
        "fontSize": 11,
        "lineHeight": 1.3,
        "letterSpacing": 0.04
      },
      "$extensions": {
        "garblo.desktopFontSize": 11,
        "garblo.uppercase": true
      }
    },
    "mono-figure": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.mono}",
        "fontWeight": 500,
        "fontSize": 28,
        "lineHeight": 1.1,
        "letterSpacing": -0.02
      },
      "$extensions": {
        "garblo.desktopFontSize": 32,
        "garblo.features": [
          "tnum",
          "zero"
        ],
        "garblo.note": "digits and units only"
      }
    },
    "label-button": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontWeight": 500,
        "fontSize": 15,
        "lineHeight": 1.2,
        "letterSpacing": 0
      },
      "$extensions": {
        "garblo.desktopFontSize": 15,
        "garblo.note": "system labels only (D40)"
      }
    },
    "label-nav": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontWeight": 500,
        "fontSize": 10,
        "lineHeight": 1.0,
        "letterSpacing": 0.04
      },
      "$extensions": {
        "garblo.desktopFontSize": 10,
        "garblo.uppercase": true,
        "garblo.textScale": "fixed 100%; long-press shows large label (D51)"
      }
    }
  }
}